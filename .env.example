# OpenRouter configuration. Copy to .env and set LLM_API_KEY there.
# The same key is used for embeddings when EMBEDDING_API_KEY is blank.
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it
LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
LLM_BASE_URL=https://openrouter.ai/api/v1

EMBEDDING_API_KEY=
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
